<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(WindowsRuntimeIdentifier)</RuntimeIdentifier>
    <PlatformTarget>$(WindowsArchitecture)</PlatformTarget>
    <Platforms>ARM64;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="..\ScrcpySend.Media\ScrcpySend.Media.csproj" />
  </ItemGroup>
  <Target Name="PublishApplicationResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI application resource index was not generated." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
