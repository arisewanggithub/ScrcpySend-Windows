<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>$(WindowsArchitecture)</PlatformTarget>
    <Platforms>ARM64;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScrcpySend.Core\ScrcpySend.Core.csproj" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <Content Include="..\..\native\$(WindowsRuntimeIdentifier)\**\*" Link="native\$(WindowsRuntimeIdentifier)\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
