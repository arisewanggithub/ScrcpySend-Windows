set(CMAKE_SYSTEM_NAME Windows)
if("$ENV{SCRCPYSEND_TARGET_ARCH}" STREQUAL "x64")
  set(CMAKE_SYSTEM_PROCESSOR AMD64)
  set(ZIG_TARGET x86_64-windows-gnu)
else()
  set(CMAKE_SYSTEM_PROCESSOR ARM64)
  set(ZIG_TARGET aarch64-windows-gnu)
endif()
file(TO_CMAKE_PATH "$ENV{SCRCPYSEND_ZIG}" ZIG_EXECUTABLE)
set(CMAKE_C_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 "cc")
set(CMAKE_CXX_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_C_FLAGS_INIT "-target ${ZIG_TARGET}")
set(CMAKE_CXX_FLAGS_INIT "-target ${ZIG_TARGET}")
set(CMAKE_RC_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_RC_COMPILER_ARG1 "rc")
